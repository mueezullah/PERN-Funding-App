generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           Int        @id @default(autoincrement())
  name         String
  username     String     @unique @db.VarChar(20)
  email        String     @unique
  password     String
  role         String     @default("user") @db.VarChar(20)
  avatar_url   String?    @db.VarChar(255)
  kyc_verified Boolean?   @default(false)

  kyc_verification KycVerification?
  created_at   DateTime   @default(now())

  campaigns    Campaign[]
  posts        Post[]
  donations    Donation[]
  comments     Comment[]
  likes        Like[]
  bookmarks    Bookmark[]

  followers    Follow[]   @relation("FollowingRelation")
  following    Follow[]   @relation("FollowerRelation")

  @@map("users")
}

model Campaign {
  id             Int        @id @default(autoincrement())
  user_id        Int
  title          String     @db.VarChar(255)
  description    String
  goal_amount    Decimal    @db.Decimal(15, 2)
  current_amount Decimal?   @default(0) @db.Decimal(15, 2)
  deadline       DateTime
  media_url      String?    @db.VarChar(255)
  status         String?    @default("active") @db.VarChar(20)
  pinned_at      DateTime?
  created_at     DateTime   @default(now())
  updated_at     DateTime   @default(now()) @updatedAt

  user           User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  donations      Donation[]
  bookmarks      Bookmark[]

  @@index([user_id], map: "idx_campaigns_user_id")
  @@index([status], map: "idx_campaigns_status")
  @@index([deadline], map: "idx_campaigns_deadline")
  @@map("campaigns")
}

model Post {
  id         Int      @id @default(autoincrement())
  user_id    Int
  content    String
  media_url  String?  @db.VarChar(255)
  status     String?  @default("active") @db.VarChar(20)
  pinned_at  DateTime?
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  bookmarks  Bookmark[]

  @@index([user_id], map: "idx_posts_user_id")
  @@index([created_at(sort: Desc)], map: "idx_posts_created_at")
  @@map("posts")
}

model Donation {
  id                       Int      @id @default(autoincrement())
  campaign_id              Int
  donor_id                 Int
  amount                   Decimal  @db.Decimal(15, 2)
  stripe_payment_intent_id String?  @unique @db.VarChar(255)
  status                   String?  @default("pending") @db.VarChar(50)
  created_at               DateTime @default(now())
  updated_at               DateTime @default(now()) @updatedAt

  campaign                 Campaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  donor                    User     @relation(fields: [donor_id], references: [id], onDelete: Cascade)

  @@index([campaign_id], map: "idx_donations_campaign_id")
  @@index([donor_id], map: "idx_donations_donor_id")
  @@index([status], map: "idx_donations_status")
  @@map("donations")
}

model Comment {
  id          Int       @id @default(autoincrement())
  user_id     Int
  target_type String    @db.VarChar(20)
  target_id   Int
  parent_id   Int?
  content     String
  created_at  DateTime  @default(now())

  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  parent      Comment?  @relation("CommentReplies", fields: [parent_id], references: [id], onDelete: Cascade)
  replies     Comment[] @relation("CommentReplies")

  @@index([target_type, target_id], map: "idx_comments_target")
  @@index([parent_id], map: "idx_comments_parent_id")
  @@index([created_at(sort: Asc)], map: "idx_comments_created_at")
  @@map("comments")
}

model Like {
  id          Int      @id @default(autoincrement())
  user_id     Int
  target_type String   @db.VarChar(20)
  target_id   Int
  created_at  DateTime @default(now())

  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, target_type, target_id])
  @@index([target_type, target_id], map: "idx_likes_target")
  @@index([user_id], map: "idx_likes_user")
  @@map("likes")
}

model Follow {
  id           Int      @id @default(autoincrement())
  follower_id  Int
  following_id Int
  created_at   DateTime @default(now())

  follower     User     @relation("FollowerRelation", fields: [follower_id], references: [id], onDelete: Cascade)
  following    User     @relation("FollowingRelation", fields: [following_id], references: [id], onDelete: Cascade)

  @@unique([follower_id, following_id], map: "unique_follow")
  @@index([follower_id], map: "idx_follows_follower")
  @@index([following_id], map: "idx_follows_following")
  @@map("follows")
}

// ─── Bookmark ─────────────────────────────────────────────────────────────────
// Polymorphic join via two nullable FKs. Exactly one of post_id / campaign_id
// must be set — enforced at the service layer.

model Bookmark {
  id          Int       @id @default(autoincrement())
  user_id     Int
  post_id     Int?
  campaign_id Int?
  created_at  DateTime  @default(now())

  user        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post        Post?     @relation(fields: [post_id], references: [id], onDelete: Cascade)
  campaign    Campaign? @relation(fields: [campaign_id], references: [id], onDelete: Cascade)

  @@unique([user_id, post_id],     map: "unique_bookmark_post")
  @@unique([user_id, campaign_id], map: "unique_bookmark_campaign")
  @@index([user_id],               map: "idx_bookmarks_user_id")
  @@map("bookmarks")
}

// ─── KYC ──────────────────────────────────────────────────────────────────────

enum DiditStatus {
  pending
  approved
  declined
  in_review
}

enum KycAdminStatus {
  pending
  approved
  rejected
}

model KycVerification {
  id               Int            @id @default(autoincrement())
  user_id          Int            @unique
  didit_session_id String         @unique @db.VarChar(255)
  didit_status     DiditStatus    @default(pending)
  admin_status     KycAdminStatus @default(pending)

  // Fields extracted from Didit's identity document scan
  extracted_name   String?        @db.VarChar(255)
  extracted_dob    String?        @db.VarChar(50)
  document_number  String?        @db.VarChar(100)

  // Full Didit webhook payload stored as JSONB for auditing
  raw_response     Json?

  created_at       DateTime       @default(now())
  updated_at       DateTime       @default(now()) @updatedAt

  user             User           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([didit_session_id], map: "idx_kyc_session_id")
  @@index([admin_status],     map: "idx_kyc_admin_status")
  @@index([user_id],          map: "idx_kyc_user_id")
  @@map("kyc_verifications")
}
