# =================================================================
# FUNDME BACKEND CONFIGURATION
# =================================================================

# Server port (default 8080)
PORT=8080
NODE_ENV=development

# JWT Secrets for Authentication (replace with strong random strings in production)
JWT_SECRET=your_jwt_secret_key_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_here
JWT_EXPIRES_IN=24h

# Database Configuration (PostgreSQL / Neon)
DB_HOST=your_db_host.neon.tech
DB_USER=your_db_user
DB_PORT=5432
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Prisma URLs (Pooled connection for queries, Direct for migrations)
DATABASE_URL="postgresql://your_db_user:your_db_password@your_db_host.neon.tech/your_db_name?sslmode=require"
DIRECT_URL="postgresql://your_db_user:your_db_password@your_direct_host.neon.tech/your_db_name?sslmode=require"

# Stripe Payment Processing
# Get test keys from Stripe Dashboard (Developers -> API Keys)
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# Didit KYC Identity Verification
DIDIT_API_CLIENT_ID=YOUR_DIDIT_API_CLIENT_ID
DIDIT_WEBHOOK_SECRET=YOUR_DIDIT_WEBHOOK_SECRET
DIDIT_WORKFLOW_ID=YOUR_DIDIT_WORKFLOW_ID

# CORS Allowed Origin
# Local: http://localhost:5173
# Production: https://your-frontend-app.netlify.app (or comma-separated URLs)
CLIENT_URL=http://localhost:5173

# AWS S3 Storage for Uploads
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=fundme-media-staging
